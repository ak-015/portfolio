# Database — must be IDENTICAL to the public project's DATABASE_URL
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio?schema=public"

# Admin session
JWT_SECRET="replace-with-a-long-random-string"
SESSION_COOKIE_NAME="admin_session"

# Seeded admin account (used only by `npm run seed:admin`)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-now"

# Cloudinary (uploads — admin is the only app that writes)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (Resend primary, Brevo SMTP fallback) — used for login + staging OTPs
RESEND_API_KEY=""
OTP_FROM_EMAIL="admin@resend.dev"
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
# SMTP login for authentication only (looks like xxxxx@smtp-brevo.com) —
# this is NOT a valid From address, Brevo will reject sends that use it.
BREVO_SMTP_USER=""
BREVO_SMTP_PASS=""
# Must be a sender verified in Brevo (Senders, Domains & Dedicated IPs).
# If you haven't set up a custom domain, use the auto-issued
# xxxxx@<your-account-id>.brevosend.com address shown there.
BREVO_FROM_EMAIL=""

# Cross-deployment cache invalidation
PUBLIC_SITE_URL="https://ankitkumar.dev"
REVALIDATE_SECRET="replace-with-a-long-random-string"

# Set to "true" only if this deployment sits behind a reverse proxy that
# overwrites (not appends to) X-Forwarded-For with the real client IP —
# e.g. Vercel. Otherwise leave unset: login/OTP rate limiting falls back
# to a shared bucket rather than trusting a spoofable client header.
TRUST_PROXY_HEADERS="false"

NEXT_PUBLIC_SITE_URL="https://admin.ankitkumar.dev"
