// ═══════════════════════════════════════════════════════════════════════
// SHARED SCHEMA — OWNED BY THE ADMIN PROJECT
// ═══════════════════════════════════════════════════════════════════════
// This file is the single source of truth for the database. Per the
// shared-foundations rule, the ADMIN project is the only place that ever
// runs `prisma migrate`. This public project consumes an identical copy
// of this file and only ever runs `prisma generate` against it.
//
// Sync mechanism: copy-on-deploy. The public repo's `prisma/schema.prisma`
// is synced from the admin repo's `prisma/schema.prisma` as a build step
// (see README "Schema Sync" section) before `prisma generate` runs.
// Do not hand-edit this file in the public repo — edits belong upstream
// in the admin repo, otherwise the two apps will drift out of sync.
// ═══════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────

enum EducationStatus {
  COMPLETED
  IN_PROGRESS
}

enum TechCategory {
  LANGUAGES
  FRONTEND
  BACKEND
  DATABASE
  TOOLS
  MOBILE
  OTHER
}

enum HobbyFieldType {
  TEXT
  TEXTAREA
  IMAGE
  DATE
  TIME
  DATETIME
  NUMBER
  RATING
  URL
  BOOLEAN
}

enum StatContext {
  HOME
  ABOUT
  EXPERIENCE
}

// MANUAL: `value` is admin-typed free text ("50+", "100%", etc).
// PROJECTS / TECHNOLOGIES / CERTIFICATES: `value` is computed at read time
// on the public site from the live row count of the matching table, unless
// overrideEnabled is set — then `value` is shown as typed instead.
enum StatSource {
  MANUAL
  PROJECTS
  TECHNOLOGIES
  CERTIFICATES
}

// ─── Site-wide singleton profile ─────────────────────────────────────

model Profile {
  id                 String   @id @default(cuid())
  name               String
  roles              String[] // rotating role titles shown in hero
  tagline            String
  profileImageUrl    String?
  resumeUrl          String?
  email              String
  phone              String
  education          String // short line, e.g. "B.Tech Civil Engineering"
  location           String
  languages          String // comma-separated display string, e.g. "English, Hindi"
  availabilityStatus String? // e.g. "Open for Freelance & Full-time Opportunities"
  bookingLink        String? // e.g. Calendly URL
  mapLatitude        Float?
  mapLongitude       Float?
  mapLocationText    String? // e.g. "Kurukshetra, Haryana, India 136118"

  aboutHeadlinePrefix String? // "Civil Engineer by "
  aboutHeadlineWord1  String? // "degree"
  aboutHeadlineMiddle String? // ", Developer by "
  aboutHeadlineWord2  String? // "passion"
  aboutIntro          String? // paragraph under the About headline
  positioningCopy     String? // "engineer-turned-developer" narrative body

  footerTagline String? // short blurb in footer under name

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model SocialLink {
  id       String  @id @default(cuid())
  platform String // e.g. "github", "linkedin", "twitter", "instagram", "youtube"
  url      String
  icon     String // icon key, e.g. "FaGithub"
  order    Int     @default(0)
  visible  Boolean @default(true)
}

model QuickLink {
  id      String @id @default(cuid())
  label   String
  href    String
  order   Int    @default(0)
  section String @default("quick") // "quick" | "services"
}

model Stat {
  id      String      @id @default(cuid())
  context StatContext // which page/section this stat strip belongs to
  label   String
  value   String // manual value, OR the override text shown when overrideEnabled=true
  icon    String
  order   Int         @default(0)

  source          StatSource @default(MANUAL)
  overrideEnabled Boolean    @default(false) // when source != MANUAL, show `value` instead of the live count
}

// Singleton — one row, id fixed to "singleton". Site-wide toggles that
// don't belong to any single content model.
model SiteSettings {
  id                String  @id @default("singleton")
  experienceVisible Boolean @default(true)
}

model ServiceItem {
  id          String @id @default(cuid())
  title       String
  description String
  icon        String
  order       Int    @default(0)
}

// ─── Technologies (shared by Tech Stack grid + Project tech chips) ───

model Technology {
  id       String         @id @default(cuid())
  name     String         @unique
  icon     String
  category TechCategory
  order    Int            @default(0)

  projects ProjectTechnology[]
}

// ─── Projects ─────────────────────────────────────────────────────────

model ProjectCategory {
  id    String    @id @default(cuid())
  name  String    @unique // e.g. "Web", "Android", "Civil Engineering", "UI/UX"
  slug  String    @unique
  order Int       @default(0)

  projects Project[]
}

model Project {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  summary        String // short card description
  description    String // long-form detail page description
  coverImageUrl  String?
  liveDemoUrl    String? // "#" placeholder when absent
  githubUrl      String? // "#" placeholder when absent
  featured       Boolean  @default(false)
  order          Int      @default(0)

  categoryId String
  category   ProjectCategory @relation(fields: [categoryId], references: [id])

  features     ProjectFeature[]
  technologies ProjectTechnology[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectFeature {
  id        String  @id @default(cuid())
  text      String
  order     Int     @default(0)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectTechnology {
  id           String     @id @default(cuid())
  projectId    String
  technologyId String
  order        Int        @default(0)
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id])

  @@unique([projectId, technologyId])
}

// ─── Experience ───────────────────────────────────────────────────────

model Experience {
  id        String   @id @default(cuid())
  role      String
  company   String
  startDate String // display string, e.g. "2026"
  endDate   String? // null => "Present"
  color     String? // node/accent color hex per reference timeline
  icon      String?
  order     Int      @default(0)

  bullets ExperienceBullet[]
}

model ExperienceBullet {
  id           String     @id @default(cuid())
  text         String
  order        Int        @default(0)
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
}

// ─── Education ─────────────────────────────────────────────────────

model EducationEntry {
  id                String          @id @default(cuid())
  degree            String
  institution       String
  startDate         String
  endDate           String
  description       String?
  status            EducationStatus @default(COMPLETED)
  gpaOrPercentage    String? // e.g. "CGPA: 7.8 / 10" or "Percentage: 82.4%"
  order             Int             @default(0)
}

model KeySubject {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)
}

model Achievement {
  id          String @id @default(cuid())
  icon        String
  title       String
  description String
  order       Int    @default(0)
}

model Certificate {
  id        String @id @default(cuid())
  title     String
  imageUrl  String
  order     Int    @default(0)
}

// ─── Blog ─────────────────────────────────────────────────────────────

model BlogPost {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  coverImageUrl String?
  excerpt       String?
  contentHtml   String // rich text body, freeform sections authored by admin
  liveDemoUrl   String?
  githubUrl     String?
  publishedAt   DateTime  @default(now())
  order         Int       @default(0)

  tags BlogPostTag[]
}

model BlogPostTag {
  id         String   @id @default(cuid())
  label      String // e.g. "React", "Node.js", "PostgreSQL"
  order      Int      @default(0)
  blogPostId String
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
}

// ─── Hobbies — dynamic field builder ─────────────────────────────────

model Hobby {
  id            String @id @default(cuid())
  name          String
  slug          String @unique
  coverImageUrl String?
  order         Int    @default(0)

  subCollections HobbySubCollection[]
}

model HobbySubCollection {
  id      String @id @default(cuid())
  name    String // e.g. "Gallery", "Read", "Currently Reading", "Future Reading"
  order   Int    @default(0)
  hobbyId String
  hobby   Hobby  @relation(fields: [hobbyId], references: [id], onDelete: Cascade)

  fields  HobbyField[]
  entries HobbyEntry[]
}

model HobbyField {
  id               String              @id @default(cuid())
  name             String // e.g. "Title", "Star Rating", "Location"
  fieldType        HobbyFieldType
  required         Boolean             @default(false)
  order            Int                 @default(0)
  subCollectionId  String
  subCollection    HobbySubCollection  @relation(fields: [subCollectionId], references: [id], onDelete: Cascade)

  values HobbyEntryValue[]
}

model HobbyEntry {
  id              String             @id @default(cuid())
  order           Int                @default(0)
  subCollectionId String
  subCollection   HobbySubCollection @relation(fields: [subCollectionId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())

  values HobbyEntryValue[]
}

model HobbyEntryValue {
  id      String     @id @default(cuid())
  value   String // all values stored as string; frontend parses per fieldType
  fieldId String
  field   HobbyField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  entryId String
  entry   HobbyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([fieldId, entryId])
}
