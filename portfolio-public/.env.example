# Database (must match the admin project's DATABASE_URL exactly)
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio?schema=public"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Email (Resend primary, Brevo SMTP fallback)
RESEND_API_KEY=""
CONTACT_TO_EMAIL="ankitkumar.dev@gmail.com"
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
# SMTP login for authentication only (looks like xxxxx@smtp-brevo.com) —
# this is NOT a valid From address, Brevo will reject sends that use it.
BREVO_SMTP_USER=""
BREVO_SMTP_PASS=""
# Must be a sender verified in Brevo (Senders, Domains & Dedicated IPs).
# If you haven't set up a custom domain, use the auto-issued
# xxxxx@<your-account-id>.brevosend.com address shown there.
BREVO_FROM_EMAIL=""

# Site
NEXT_PUBLIC_SITE_URL="https://ankitkumar.dev"

# Cross-deployment cache invalidation — must be IDENTICAL to the admin
# project's REVALIDATE_SECRET. Admin POSTs here after every commit via
# lib/revalidate.ts -> this project's app/api/revalidate/route.ts.
REVALIDATE_SECRET="replace-with-a-long-random-string"
